{
  "title": "Watchtower / Service Overview",
  "uid": "watchtower-overview",
  "description": "Grafana dashboard for Watchtower — S3 event monitoring and AI processing service",
  "tags": ["watchtower", "go", "s3", "processing"],
  "timezone": "browser",
  "editable": true,
  "hideControls": false,
  "sharedCrosshair": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "type": "datasource",
          "selected": true
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "label": "Data Source"
      },
      {
        "name": "service",
        "type": "query",
        "query": "label_values(up{job=~\"watchtower.*\"}, service)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "allValue": ".*",
        "label": "Service",
        "refresh": 1
      },
      {
        "name": "status",
        "type": "query",
        "query": "label_values(watchtower_orchestrator_processed_total{service=~\"$service\"}, status)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "label": "Status",
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "collapsed": false,
      "title": "HTTP API",
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "type": "row"
    },
    {
      "id": 1,
      "title": "HTTP Requests per Second",
      "description": "Rate of all HTTP requests, split by status code class",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "spanNulls": false,
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["max", "mean"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (status_code) (rate(http_requests_total{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{ status_code }}",
          "intervalFactor": 1
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Request Duration (p50 / p90 / p99)",
      "description": "Histogram quantiles — overall request latency across all paths",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "spanNulls": false,
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["max", "mean"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{service=~\"$service\"}[$__rate_interval])) by (le))",
          "legendFormat": "p50",
          "intervalFactor": 1
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(http_request_duration_seconds_bucket{service=~\"$service\"}[$__rate_interval])) by (le))",
          "legendFormat": "p90",
          "intervalFactor": 1
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{service=~\"$service\"}[$__rate_interval])) by (le))",
          "legendFormat": "p99",
          "intervalFactor": 1
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP Requests In Progress",
      "description": "Number of requests currently being handled",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "spanNulls": false,
            "fillOpacity": 20
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["max", "mean"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(http_requests_in_progress_total{service=~\"$service\"})",
          "legendFormat": "In Progress",
          "intervalFactor": 1
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP Requests by Method & Path",
      "description": "Top-N request rate broken down by method and route",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "transformations": [
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "method": {
                "aggregations": [],
                "operation": "groupby"
              },
              "path": {
                "aggregations": [],
                "operation": "groupby"
              },
              "Value": {
                "aggregations": [
                  {
                    "id": "sum",
                    "type": "sum"
                  }
                ],
                "operation": "aggregate"
              }
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "desc": true,
                "field": "Value (sum)"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "align": "auto"
          },
          "displayName": "RPS"
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Value (sum)"
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=~\"$service\"}[$__rate_interval])) by (method, path)",
          "legendFormat": "{{ method }} {{ path }}",
          "intervalFactor": 1
        }
      ]
    },
    {
      "collapsed": false,
      "title": "RabbitMQ / Queue",
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "type": "row"
    },
    {
      "id": 5,
      "title": "RMQ Reconnects",
      "description": "Total RabbitMQ reconnection events, split by success/failure",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "showPoints": "never",
            "lineInterpolation": "stepBefore",
            "spanNulls": false,
            "fillOpacity": 20
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "/.*failed.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "/.*success.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": ["max", "mean", "last"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "rate(watchtower_rmq_reconnect_total{service=~\"$service\"}[$__rate_interval])",
          "legendFormat": "{{ is_failed }}",
          "intervalFactor": 1
        }
      ]
    },
